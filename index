  } else if (type === 'payment') {
    const rows = students.map(s => `<tr><td>${s.id}</td><td>${s.name}</td><td>${s.class}</td><td>${formatMoney(getTotalPaid(s))}</td><td>${formatMoney(getOutstanding(s))}</td></tr>`).join('');
    content = `<h2>Payment Report</h2><table border="1" style="width:100%;border-collapse:collapse"><thead><tr><th>ID</th><th>Name</th><th>Class</th><th>Paid</th><th>Outstanding</th></tr></thead><tbody>${rows}</tbody></table>`;
  } else {
    const rows = students.map(s => `<tr><td>${s.id}</td><td>${s.name}</td><td>${s.class}</td><td>${getStudentAvg(s)}%</td><td>${getGrade(getStudentAvg(s)).grade}</td></tr>`).join('');
    content = `<h2>Academic Summary</h2><table border="1" style="width:100%;border-collapse:collapse"><thead><tr><th>ID</th><th>Name</th><th>Class</th><th>Average</th><th>Grade</th></tr></thead><tbody>${rows}</tbody></table>`;
  }
  w.document.write(`<!DOCTYPE html><html><head><title>Report - Scholar's Camp</title><style>body{font-family:Arial,sans-serif;padding:20px}h1{color:#1a3a8c}table{border-collapse:collapse}td,th{padding:8px 12px}</style></head><body><h1>Scholar's Camp Tutorial Centre</h1>${content}<script>window.onload=()=>window.print()<\/script></body></html>`);
  w.document.close();
}

