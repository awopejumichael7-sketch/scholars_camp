/* ============================================
   HELPER FUNCTIONS
============================================ */
function getStudentAvg(s) {
  const scores = Object.values(s.scores).filter(v => v > 0);
  if (!scores.length) return 0;
  return Math.round(scores.reduce((a,b) => a+b, 0) / scores.length);
}

function getGrade(score) {
  if (score >= 75) return { grade:'A', remark:'Excellent' };
  if (score >= 60) return { grade:'B', remark:'Good' };
  if (score >= 50) return { grade:'C', remark:'Average' };
  if (score >= 45) return { grade:'D', remark:'Pass' };
  return { grade:'F', remark:'Fail' };
}

function getAttendancePct(s) {
  let total = 0, present = 0;
  for (let m = 0; m < 6; m++) {
    const days = s.attendance[m] || [];
    total += days.length;
    present += days.filter(d => d === 1).length;
  }
  if (!total) return 0;
  return Math.round((present / total) * 100);
}

function getTotalPaid(s) {
  return Object.values(s.payments).reduce((a,b) => a+b, 0);
}

function getTotalDue(s) {
  // 5 months (Jan-May) × monthly fee
  return s.monthlyFee * 5;
}

function getOutstanding(s) {
  return Math.max(0, getTotalDue(s) - getTotalPaid(s));
}

function getBestSubject(s) {
  const entries = Object.entries(s.scores).filter(e => e[1] > 0);
  if (!entries.length) return null;
  return entries.reduce((a,b) => b[1] > a[1] ? b : a);
}

function getWeakSubject(s) {
  const entries = Object.entries(s.scores).filter(e => e[1] > 0);
  if (!entries.length) return null;
  return entries.reduce((a,b) => b[1] < a[1] ? b : a);
}

function getInitials(name) {
  return name.split(' ').slice(0,2).map(n => n[0]).join('').toUpperCase();
}

function nextStudentId() {
  const nums = students.map(s => parseInt(s.id.replace('SC','')));
  const max = Math.max(...nums, 20);
  return 'SC' + String(max+1).padStart(3,'0');
}

function formatMoney(n) { return '₦' + Number(n).toLocaleString(); }

function fmtSubject(k) { return k.replace(/([A-Z])/g, ' $1').trim(); }

/* ============================================
   TOAST
============================================ */
function showToast(msg, type='info', duration=3500) {
  const icons = { success:'fas fa-check-circle', error:'fas fa-times-circle', warning:'fas fa-exclamation-circle', info:'fas fa-info-circle' };
  const colors = { success:'#4ade80', error:'#f87171', warning:'#fbbf24', info:'#60a5fa' };
  const el = document.createElement('div');
  el.className = `toast toast-${type}`;
  el.innerHTML = `<i class="${icons[type]}" style="color:${colors[type]};font-size:1.1rem"></i><span style="flex:1">${msg}</span>`;
  document.getElementById('toast-container').appendChild(el);
  setTimeout(() => { el.style.animation = 'toastIn 0.3s ease reverse'; setTimeout(() => el.remove(), 300); }, duration);
}

/* ============================================
   PAGE NAVIGATION
============================================ */
function showPage(id) {
  stopTTS();
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  if (id === 'landing-page') {
    setTimeout(startTTS, 1000);
    startCounters();
    initSlider();
    createParticles();
  }
  if (id === 'admin-dashboard') {
    initDashboard();
  }
  window.scrollTo(0, 0);
}

function scrollTo(id) {
  document.getElementById(id)?.scrollIntoView({ behavior:'smooth' });
}

/* ============================================
   MOBILE NAV
============================================ */
function toggleMobileNav() {
  const nav = document.getElementById('mobileNav');
  nav.style.display = nav.style.display === 'none' ? 'block' : 'none';
}
function closeMobileNav() {
  document.getElementById('mobileNav').style.display = 'none';
