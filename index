/* ============================================
   ENHANCED: CLASS PERFORMANCE SUMMARY
   Shows per-class average in a mini chart
============================================ */
function renderClassSummary() {
  const classes = ['JSS 1','JSS 2','JSS 3','SS 1','SS 2','SS 3'];
  const summaries = classes.map(cls => {
    const group = students.filter(s => s.class === cls);
    if (!group.length) return null;
    const avg = Math.round(group.reduce((a,s) => a + getStudentAvg(s), 0) / group.length);
    const attendance = Math.round(group.reduce((a,s) => a + getAttendancePct(s), 0) / group.length);
    const outstanding = group.reduce((a,s) => a + getOutstanding(s), 0);
    return { cls, count: group.length, avg, attendance, outstanding };
  }).filter(Boolean);
  return summaries;
}

