      const p = days.filter(d => d === 1).length;
      return `<td>${p}/${days.length || '—'}</td>`;
    }).join('');
    let total = 0, present = 0;
    for (let m=0;m<6;m++) { const d=s.attendance[m]||[]; total+=d.length; present+=d.filter(x=>x===1).length; }
    const pct = total ? Math.round((present/total)*100) : 0;
