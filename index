function renderAttDaysGrid() {
  const grid = document.getElementById('att_days_grid');
  if (!grid) return;
  const month = parseInt(document.getElementById('att_month').value);
  const studentId = document.getElementById('att_student').value;
  const s = students.find(st => st.id === studentId);
  const days = (s && s.attendance[month]) ? [...s.attendance[month]] : [];
  const statusColors = { '1':'rgba(34,197,94,0.3)', '0':'rgba(239,68,68,0.3)', '2':'rgba(245,158,11,0.3)', '3':'rgba(59,130,246,0.3)' };
  const statusLabels = { '1':'P', '0':'A', '2':'L', '3':'E' };
  const statusNames = { '1':'Present', '0':'Absent', '2':'Late', '3':'Excused' };
  grid.innerHTML = [...Array(20)].map((_, i) => {
    const current = days[i] !== undefined ? String(days[i]) : '-1';
    const btns = Object.entries(statusLabels).map(([v, label]) =>
      `<button type="button" onclick="setDayStatus(${i},${v})" id="att_btn_${i}_${v}"
        style="flex:1;padding:4px 0;font-size:0.7rem;font-weight:700;border-radius:4px;border:1px solid var(--glass-border);
        background:${current===v ? statusColors[v] : 'transparent'};
        color:${current===v ? '#fff' : 'var(--gray-400)'};cursor:pointer;transition:all 0.2s"
        title="${statusNames[v]}">${label}</button>`
    ).join('');
    const bg = current !== '-1' ? statusColors[current] : 'var(--glass)';
    return `<div id="att_day_cell_${i}" style="background:${bg};border:1px solid var(--glass-border);border-radius:8px;padding:8px;transition:background 0.3s">
      <div style="font-size:0.75rem;font-weight:700;color:var(--gold);margin-bottom:6px;text-align:center">Day ${i+1}</div>
      <div style="display:flex;gap:3px;">${btns}</div>
      <input type="hidden" id="att_day_val_${i}" value="${current}">
    </div>`;
  }).join('');
}

// Called when user clicks a status button for a day
function setDayStatus(dayIndex, value) {
  const valInput = document.getElementById(`att_day_val_${dayIndex}`);
  valInput.value = value;
  const statusColors = { '1':'rgba(34,197,94,0.3)', '0':'rgba(239,68,68,0.3)', '2':'rgba(245,158,11,0.3)', '3':'rgba(59,130,246,0.3)' };
  const cell = document.getElementById(`att_day_cell_${dayIndex}`);
  cell.style.background = statusColors[value] || 'var(--glass)';
  // Update button highlights
  [1,0,2,3].forEach(v => {
    const btn = document.getElementById(`att_btn_${dayIndex}_${v}`);
    if (!btn) return;
    if (v === value) {
      btn.style.background = statusColors[v];
      btn.style.color = '#fff';
    } else {
      btn.style.background = 'transparent';
      btn.style.color = 'var(--gray-400)';
    }
  });
}

// Override the existing saveAttendance to use new inputs
function saveAttendance() {
  const studentId = document.getElementById('att_student').value;
  const month = parseInt(document.getElementById('att_month').value);
  const s = students.find(st => st.id === studentId);
  if (!s) return;
  const days = [];
  for (let i = 0; i < 20; i++) {
    const v = document.getElementById(`att_day_val_${i}`);
    if (v && v.value !== '-1') days.push(parseInt(v.value));
  }
  s.attendance[month] = days;
  closeModal('attendanceModal');
  renderAttendance();
  if (currentStudent && currentStudent.id === studentId) renderStudentAttendance(s);
  showToast(`Attendance saved for ${s.name} — ${MONTHS[month]}`, 'success');
}

/* ============================================
   ENHANCED: INLINE SCORE EDITING
   Admin can edit scores directly from performance table
============================================ */
function editScoreInline(studentId, subjectKey) {
  const s = students.find(st => st.id === studentId);
  if (!s) return;
  const current = s.scores[subjectKey] || 0;
  const newScore = prompt(`Edit ${fmtSubject(subjectKey)} score for ${s.name}\nCurrent: ${current}\nEnter new score (0–100):`, current);
  if (newScore === null) return;
  const parsed = parseInt(newScore);
  if (isNaN(parsed) || parsed < 0 || parsed > 100) {
    showToast('Please enter a valid score between 0 and 100', 'warning');
    return;
  }
  s.scores[subjectKey] = parsed;
  renderPerformanceTable();
  renderTopStudents();
  renderDashCards();
  showToast(`Score updated: ${fmtSubject(subjectKey)} → ${parsed}%`, 'success');
}

// Rebuild performance table with click-to-edit scores
function renderPerformanceTable() {
  const body = document.getElementById('performanceTableBody');
  if (!body) return;
  const ranked = [...students].map(s => ({ ...s, avg: getStudentAvg(s) })).sort((a,b) => b.avg - a.avg);
  body.innerHTML = ranked.map((s, i) => {
    const { grade } = getGrade(s.avg);
    const subKeys = ['Mathematics','EnglishLanguage','Physics','Chemistry','Biology','Economics'];
    const cells = subKeys.map(k => {
      const score = s.scores[k];
      const display = score > 0 ? score : '—';
      return `<td><span onclick="editScoreInline('${s.id}','${k}')" title="Click to edit"
        style="cursor:pointer;padding:2px 8px;border-radius:4px;transition:background 0.2s;display:inline-block"
        onmouseover="this.style.background='rgba(212,160,23,0.15)'" onmouseout="this.style.background='transparent'">
        ${display}${score>0?'<i class="fas fa-pen" style="font-size:0.6rem;margin-left:4px;color:var(--gray-600)"></i>':''}
        </span></td>`;
    }).join('');
    return `<tr>
      <td><div style="display:flex;align-items:center;gap:8px">
        <div class="student-photo" style="width:28px;height:28px;font-size:0.65rem">${getInitials(s.name)}</div>${s.name}
      </div></td>
      <td>${s.class}</td>
      ${cells}
      <td><strong>${s.avg}%</strong></td>
      <td><span class="badge ${getBadgeClass(s.avg)}">${grade}</span></td>
      <td><span class="badge badge-gold">#${i+1}</span></td>
      <td><button class="btn btn-icon btn-sm" onclick="viewStudent('${s.id}')"><i class="fas fa-eye"></i></button></td>
    </tr>`;
  }).join('');
}

