  // Build results from student scores + manual results
  const allResults = [];
  students.forEach(s => {
    SUBJECTS.forEach(sub => {
      const key = sub.replace(/ /g,'');
      const score = s.scores[key];
      if (score > 0) {
        const ca = Math.round(score * 0.4);
        const exam = Math.round(score * 0.6);
        const { grade, remark } = getGrade(score);
        allResults.push({ studentId:s.id, studentName:s.name, subject:sub, ca, exam, total:score, grade, remark });
      }
    });
  });
  results.forEach(r => allResults.push(r));
  if (!allResults.length) { body.innerHTML = '<tr><td colspan="8" style="text-align:center;color:var(--gray-400);padding:40px">No results uploaded yet</td></tr>'; return; }
  body.innerHTML = allResults.slice(0,50).map(r => `<tr>
    <td>${r.studentName}</td>
    <td>${r.subject}</td>
    <td>${r.ca}</td>
    <td>${r.exam}</td>
    <td><strong>${r.total}</strong></td>
