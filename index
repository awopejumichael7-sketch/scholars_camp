function generateAIAnalysis(s) {
  const avg = getStudentAvg(s);
  const best = getBestSubject(s);
  const weak = getWeakSubject(s);
  const att = getAttendancePct(s);
  let text = '';
  if (avg >= 80) text = `${s.name.split(' ')[0]} is an outstanding performer with an impressive average of ${avg}%. `;
  else if (avg >= 65) text = `${s.name.split(' ')[0]} demonstrates solid academic performance with an average of ${avg}%. `;
  else text = `${s.name.split(' ')[0]} is working towards academic improvement with a current average of ${avg}%. `;
  if (best) text += `The student excels particularly in ${fmtSubject(best[0])} (${best[1]}%), showing exceptional aptitude in this area. `;
  if (weak && weak[1] < 60) text += `However, ${fmtSubject(weak[0])} (${weak[1]}%) requires additional focus and practice. `;
  if (att >= 90) text += `Excellent attendance at ${att}% is commendable and directly contributes to academic success. `;
  else if (att < 75) text += `Attendance of ${att}% is below the recommended 85%. Improved attendance is strongly advised. `;
  if (avg >= 75) text += 'Keep up the excellent work and continue pushing for even greater heights!';
  else text += 'With consistent effort and targeted support, significant improvement is achievable.';
  return text;
}

