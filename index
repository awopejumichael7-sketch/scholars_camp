function saveResult() {
  const studentId = document.getElementById('res_student').value;
  const subject = document.getElementById('res_subject').value;
  const ca = parseInt(document.getElementById('res_ca').value) || 0;
  const exam = parseInt(document.getElementById('res_exam').value) || 0;
  const total = ca + exam;
  const { grade, remark } = getGrade(total);
  const s = students.find(st => st.id === studentId);
  if (!s) return;
  // Update scores
  const key = subject.replace(/ /g,'');
  s.scores[key] = total;
  results.push({ studentId, studentName:s.name, subject, ca, exam, total, grade, remark });
  closeModal('resultModal');
  renderResults();
  showToast('Result saved successfully','success');
}

function deleteResult(sid, sub) {
  const s = students.find(st => st.id === sid);
  if (s) s.scores[sub.replace(/ /g,'')] = 0;
  results = results.filter(r => !(r.studentId === sid && r.subject === sub));
  renderResults();
  showToast('Result deleted','info');
}

