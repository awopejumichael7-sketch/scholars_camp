   TEXT TO SPEECH
============================================ */
let ttsUtterance = null;
let ttsMuted = false;
const TTS_MSG = "Welcome to Scholar's Camp Tutorial Centre, a center of excellence, a place your ward should be. We are committed to academic excellence, character development, and helping students achieve outstanding educational success.";

function startTTS() {
  if (!window.speechSynthesis) return;
  stopTTS();
  ttsUtterance = new SpeechSynthesisUtterance(TTS_MSG);
  ttsUtterance.rate = 0.9;
  ttsUtterance.pitch = 1;
  ttsUtterance.volume = ttsMuted ? 0 : 1;
  ttsUtterance.onstart = () => {
    document.getElementById('ttsBar').classList.remove('hidden-bar');
    document.getElementById('ttsWave').classList.remove('paused');
  };
  ttsUtterance.onend = () => {
    document.getElementById('ttsWave').classList.add('paused');
  };
  speechSynthesis.speak(ttsUtterance);
}

function stopTTS() {
  if (window.speechSynthesis) {
    speechSynthesis.cancel();
  }
  document.getElementById('ttsBar').classList.add('hidden-bar');
}

function toggleTTS() {
  ttsMuted = !ttsMuted;
  const icon = document.getElementById('ttsIcon');
  if (ttsMuted) {
    icon.className = 'fas fa-volume-xmark';
    if (ttsUtterance) ttsUtterance.volume = 0;
    speechSynthesis.pause();
    document.getElementById('ttsWave').classList.add('paused');
  } else {
    icon.className = 'fas fa-volume-up';
    if (ttsUtterance) ttsUtterance.volume = 1;
    speechSynthesis.resume();
    document.getElementById('ttsWave').classList.remove('paused');
  }
}

function replayTTS() {
  ttsMuted = false;
  document.getElementById('ttsIcon').className = 'fas fa-volume-up';
  startTTS();
}

function closeTTSBar() {
  stopTTS();
  document.getElementById('ttsBar').classList.add('hidden-bar');
}

