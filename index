  </div>

  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-grid"></div>
    <div class="hero-particles" id="particles"></div>
    <div class="hero-orb"></div>
    <div class="hero-card-float">
      <div class="floating-stat glass-card" style="animation:float 5s ease-in-out infinite">
        <div class="num" id="hero-count-1">0</div>
        <div class="lbl">Active Students</div>
      </div>
      <div class="floating-stat glass-card" style="animation:float 5s ease-in-out 1s infinite">
        <div class="num">98%</div>
        <div class="lbl">Success Rate</div>
      </div>
      <div class="floating-stat glass-card" style="animation:float 5s ease-in-out 2s infinite">
        <div class="num">8+</div>
        <div class="lbl">Subjects Offered</div>
      </div>
    </div>
