/* ============================================
   COUNTERS
============================================ */
function startCounters() {
  document.querySelectorAll('.counter-num[data-target]').forEach(el => {
    const target = parseInt(el.dataset.target);
    let current = 0;
    const step = target / 60;
    const timer = setInterval(() => {
      current = Math.min(current + step, target);
      el.textContent = Math.floor(current) + (el.dataset.target == '98' ? '%' : '+');
      if (current >= target) clearInterval(timer);
    }, 25);
  });
  // Hero count
  setTimeout(() => {
    const el = document.getElementById('hero-count-1');
    if (el) { let c = 0; const t = setInterval(() => { c = Math.min(c+2, students.length); el.textContent = c+'+'; if(c>=students.length) clearInterval(t); }, 50); }
  }, 500);
}

