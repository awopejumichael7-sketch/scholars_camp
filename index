  </button>
  <button class="btn btn-icon btn-sm" onclick="replayTTS()" title="Replay">
    <i class="fas fa-redo"></i>
  </button>
  <button class="btn btn-icon btn-sm" onclick="closeTTSBar()" title="Close">
