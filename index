function submitEnrollForm() {
  const parent = document.getElementById('enroll_parent')?.value.trim();
  const child = document.getElementById('enroll_child')?.value.trim();
  const phone = document.getElementById('enroll_phone')?.value.trim();
  if (!parent || !child || !phone) {
    showToast('Please fill in required fields', 'warning');
    return;
  }
  showToast(`Thank you, ${parent}! We'll contact you soon about enrolling ${child}.`, 'success', 5000);
  ['enroll_parent','enroll_child','enroll_phone','enroll_email','enroll_msg'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.value = '';
  });
}

