/* ============================================
   ENHANCED: TOPBAR GLOBAL SEARCH
   Searches across students, shows dropdown
============================================ */
let searchDropdown = null;
function globalSearchFn(q) {
  // Remove old dropdown
  if (searchDropdown) { searchDropdown.remove(); searchDropdown = null; }
  if (!q || q.length < 2) return;

  const results_s = students.filter(s =>
    s.name.toLowerCase().includes(q.toLowerCase()) ||
    s.id.toLowerCase().includes(q.toLowerCase()) ||
    s.class.toLowerCase().includes(q.toLowerCase())
  ).slice(0, 6);

  if (!results_s.length) return;

  const input = document.getElementById('globalSearch');
  const rect = input.getBoundingClientRect();
  searchDropdown = document.createElement('div');
  searchDropdown.style.cssText = `position:fixed;top:${rect.bottom+4}px;left:${rect.left}px;width:${rect.width}px;background:var(--navy-mid);border:1px solid var(--glass-border);border-radius:var(--radius-sm);z-index:9000;box-shadow:var(--shadow-card);overflow:hidden`;
  searchDropdown.innerHTML = results_s.map(s => {
    const avg = getStudentAvg(s);
    return `<div onclick="viewStudent('${s.id}');searchDropdown&&searchDropdown.remove()" style="padding:10px 14px;display:flex;align-items:center;gap:10px;cursor:pointer;transition:background 0.15s" onmouseover="this.style.background='var(--glass)'" onmouseout="this.style.background='transparent'">
      <div class="student-photo" style="width:30px;height:30px;font-size:0.7rem;flex-shrink:0">${getInitials(s.name)}</div>
      <div style="flex:1;min-width:0">
        <div style="font-size:0.85rem;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${s.name}</div>
        <div style="font-size:0.72rem;color:var(--gray-400)">${s.id} • ${s.class} • Avg: ${avg}%</div>
      </div>
      <span class="badge ${getBadgeClass(avg)}" style="flex-shrink:0">${getGrade(avg).grade}</span>
    </div>`;
  }).join('') + `<div style="padding:8px 14px;font-size:0.75rem;color:var(--gray-600);border-top:1px solid var(--glass-border)">
    ${results_s.length} result${results_s.length!==1?'s':''} — press Enter to search all
  </div>`;
  document.body.appendChild(searchDropdown);

  // Close on outside click
  setTimeout(() => document.addEventListener('click', function handler(e) {
    if (!searchDropdown?.contains(e.target) && e.target.id !== 'globalSearch') {
      searchDropdown?.remove(); searchDropdown = null;
      document.removeEventListener('click', handler);
    }
  }), 10);
}

// Enter key on global search — goes to students tab and filters
document.getElementById('globalSearch')?.addEventListener('keydown', e => {
  if (e.key === 'Enter') {
    const q = e.target.value;
    if (searchDropdown) { searchDropdown.remove(); searchDropdown = null; }
    if (q) {
      switchTab('dash-students');
      document.getElementById('studentSearch').value = q;
      renderStudents(q);
    }
  }
});

