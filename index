    <a href="#about" onclick="closeMobileNav()" style="display:block;padding:12px 0;border-bottom:1px solid var(--glass-border);color:var(--gray-200)">About Us</a>
    <a href="#why-us" onclick="closeMobileNav()" style="display:block;padding:12px 0;border-bottom:1px solid var(--glass-border);color:var(--gray-200)">Why Choose Us</a>
    <a href="#testimonials" onclick="closeMobileNav()" style="display:block;padding:12px 0;border-bottom:1px solid var(--glass-border);color:var(--gray-200)">Testimonials</a>
    <a href="#contact" onclick="closeMobileNav()" style="display:block;padding:12px 0;border-bottom:1px solid var(--glass-border);color:var(--gray-200)">Contact</a>
    <div style="display:flex;gap:10px;margin-top:16px">
      <button class="btn btn-outline w-full" onclick="closeMobileNav();showPage('student-login')">Student Portal</button>
      <button class="btn btn-gold w-full" onclick="closeMobileNav();showPage('admin-login')">Admin Portal</button>
