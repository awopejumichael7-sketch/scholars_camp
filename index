<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Scholar's Camp Tutorial Centre - Center of Excellence. Premium educational management system for students and administrators.">
<meta name="theme-color" content="#0a1628">
<title>Scholar's Camp Tutorial Centre | Center of Excellence</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
/* ============================================
   CSS CUSTOM PROPERTIES & RESET
============================================ */
:root {
  --royal-blue: #1a3a8c;
  --gold: #d4a017;
  --gold-light: #f0c040;
  --deep-navy: #0a1628;
  --navy-mid: #0f2040;
  --navy-card: #12243a;
  --white: #ffffff;
  --gray-100: #f0f4ff;
  --gray-200: #d0d8f0;
  --gray-400: #8898bb;
  --gray-600: #4a5a7a;
  --success: #22c55e;
  --warning: #f59e0b;
  --danger: #ef4444;
  --info: #3b82f6;
  --glass: rgba(255,255,255,0.06);
  --glass-border: rgba(255,255,255,0.12);
  --glass-hover: rgba(255,255,255,0.10);
  --shadow-glow: 0 0 40px rgba(26,58,140,0.4);
  --shadow-card: 0 8px 32px rgba(0,0,0,0.4);
  --font-display: 'Playfair Display', serif;
  --font-body: 'DM Sans', sans-serif;
  --sidebar-w: 260px;
  --radius: 16px;
  --radius-sm: 8px;
  --transition: all 0.3s cubic-bezier(0.4,0,0.2,1);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;font-size:16px}
body{font-family:var(--font-body);background:var(--deep-navy);color:var(--white);min-height:100vh;overflow-x:hidden}
a{color:inherit;text-decoration:none}
button{cursor:pointer;border:none;outline:none;font-family:var(--font-body)}
input,select,textarea{font-family:var(--font-body);outline:none}
img{max-width:100%}
::-webkit-scrollbar{width:6px}
::-webkit-scrollbar-track{background:var(--deep-navy)}
::-webkit-scrollbar-thumb{background:var(--royal-blue);border-radius:3px}

/* ============================================
   UTILITY CLASSES
============================================ */
.hidden{display:none!important}
.flex{display:flex}
.items-center{align-items:center}
.justify-between{justify-content:space-between}
.gap-1{gap:8px}.gap-2{gap:16px}.gap-3{gap:24px}
.text-gold{color:var(--gold)}
.text-sm{font-size:0.85rem}
.text-xs{font-size:0.75rem}
.text-lg{font-size:1.1rem}
.font-bold{font-weight:700}
.mt-1{margin-top:8px}.mt-2{margin-top:16px}.mt-3{margin-top:24px}
.mb-1{margin-bottom:8px}.mb-2{margin-bottom:16px}
.p-1{padding:8px}.p-2{padding:16px}.p-3{padding:24px}
.w-full{width:100%}
.rounded{border-radius:var(--radius)}
.truncate{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

/* ============================================
   GLASSMORPHISM COMPONENTS
============================================ */
.glass-card{
  background:var(--glass);
  backdrop-filter:blur(20px);
  -webkit-backdrop-filter:blur(20px);
  border:1px solid var(--glass-border);
  border-radius:var(--radius);
  transition:var(--transition);
}
.glass-card:hover{background:var(--glass-hover);border-color:rgba(212,160,23,0.3)}

/* ============================================
   BUTTONS
============================================ */
.btn{
  display:inline-flex;align-items:center;gap:8px;
  padding:10px 24px;border-radius:50px;
  font-size:0.9rem;font-weight:600;
  transition:var(--transition);cursor:pointer;
  white-space:nowrap;
}
.btn-primary{
  background:linear-gradient(135deg,var(--royal-blue),#2a5ad4);
  color:var(--white);
  box-shadow:0 4px 20px rgba(26,58,140,0.5);
}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 6px 28px rgba(26,58,140,0.7)}
.btn-gold{
  background:linear-gradient(135deg,var(--gold),#e8b820);
  color:var(--deep-navy);
  box-shadow:0 4px 20px rgba(212,160,23,0.4);
  font-weight:700;
}
.btn-gold:hover{transform:translateY(-2px);box-shadow:0 6px 28px rgba(212,160,23,0.6)}
.btn-outline{
  background:transparent;
  border:2px solid var(--glass-border);
  color:var(--white);
}
.btn-outline:hover{background:var(--glass);border-color:var(--gold)}
.btn-danger{background:linear-gradient(135deg,#dc2626,#b91c1c);color:#fff}
.btn-success{background:linear-gradient(135deg,#16a34a,#15803d);color:#fff}
.btn-sm{padding:6px 16px;font-size:0.8rem}
.btn-icon{padding:8px;border-radius:8px;background:var(--glass);border:1px solid var(--glass-border)}
.btn-icon:hover{background:var(--glass-hover)}

/* ============================================
   FORMS
============================================ */
.form-group{margin-bottom:18px}
.form-group label{display:block;font-size:0.85rem;font-weight:600;color:var(--gray-200);margin-bottom:6px}
.form-control{
  width:100%;padding:12px 16px;
  background:rgba(255,255,255,0.07);
  border:1px solid var(--glass-border);
  border-radius:var(--radius-sm);
  color:var(--white);
  font-size:0.9rem;
  transition:var(--transition);
}
.form-control:focus{border-color:var(--royal-blue);background:rgba(26,58,140,0.15);box-shadow:0 0 0 3px rgba(26,58,140,0.25)}
.form-control option{background:var(--navy-card);color:var(--white)}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:16px}
@media(max-width:600px){.form-row{grid-template-columns:1fr}}
.input-group{position:relative}
.input-group .form-control{padding-left:44px}
.input-group .input-icon{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--gray-400);font-size:1rem}
.input-group .toggle-pw{position:absolute;right:14px;top:50%;transform:translateY(-50%);color:var(--gray-400);cursor:pointer;background:none;border:none;color:var(--gray-400)}

/* ============================================
   BADGES
============================================ */
.badge{
  display:inline-block;padding:3px 10px;border-radius:50px;
  font-size:0.72rem;font-weight:700;letter-spacing:0.5px;text-transform:uppercase;
}
.badge-success{background:rgba(34,197,94,0.2);color:#4ade80}
.badge-warning{background:rgba(245,158,11,0.2);color:#fbbf24}
.badge-danger{background:rgba(239,68,68,0.2);color:#f87171}
.badge-info{background:rgba(59,130,246,0.2);color:#60a5fa}
.badge-gold{background:rgba(212,160,23,0.2);color:var(--gold-light)}

/* ============================================
   MODALS
============================================ */
.modal-overlay{
  position:fixed;inset:0;
  background:rgba(0,0,0,0.7);
  backdrop-filter:blur(4px);
  z-index:1000;
  display:flex;align-items:center;justify-content:center;
  padding:20px;
  opacity:0;pointer-events:none;
  transition:opacity 0.3s;
}
.modal-overlay.active{opacity:1;pointer-events:all}
.modal{
  background:var(--navy-mid);
  border:1px solid var(--glass-border);
  border-radius:var(--radius);
  width:100%;max-width:600px;
  max-height:90vh;overflow-y:auto;
  padding:30px;
  transform:scale(0.95) translateY(20px);
  transition:var(--transition);
}
.modal-overlay.active .modal{transform:scale(1) translateY(0)}
.modal-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px}
.modal-title{font-family:var(--font-display);font-size:1.3rem;color:var(--gold)}
.modal-close{background:var(--glass);border:1px solid var(--glass-border);color:var(--white);width:32px;height:32px;border-radius:6px;font-size:1rem;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:var(--transition)}
.modal-close:hover{background:var(--danger);border-color:var(--danger)}
.modal-lg{max-width:800px}
.modal-xl{max-width:960px}

/* ============================================
   TOASTS
============================================ */
#toast-container{position:fixed;bottom:24px;right:24px;z-index:9999;display:flex;flex-direction:column;gap:10px}
.toast{
  background:var(--navy-mid);border:1px solid var(--glass-border);
  border-radius:var(--radius-sm);padding:14px 20px;
  min-width:280px;max-width:380px;
  display:flex;align-items:center;gap:12px;
  box-shadow:var(--shadow-card);
  animation:toastIn 0.3s ease;
}
.toast-success{border-left:4px solid var(--success)}
.toast-error{border-left:4px solid var(--danger)}
.toast-warning{border-left:4px solid var(--warning)}
.toast-info{border-left:4px solid var(--info)}
@keyframes toastIn{from{transform:translateX(100%);opacity:0}to{transform:translateX(0);opacity:1}}

/* ============================================
   TABLES
============================================ */
.table-wrapper{overflow-x:auto;border-radius:var(--radius);border:1px solid var(--glass-border)}
table{width:100%;border-collapse:collapse}
thead{background:rgba(26,58,140,0.4)}
thead th{padding:12px 16px;font-size:0.8rem;font-weight:700;text-transform:uppercase;letter-spacing:0.8px;color:var(--gray-200);text-align:left;white-space:nowrap}
tbody tr{border-top:1px solid var(--glass-border);transition:var(--transition)}
tbody tr:hover{background:var(--glass)}
tbody td{padding:12px 16px;font-size:0.875rem}
.table-actions{display:flex;gap:6px}

/* ============================================
   STATS CARDS
============================================ */
.stat-card{
  background:var(--glass);
  border:1px solid var(--glass-border);
  border-radius:var(--radius);
  padding:20px 24px;
  transition:var(--transition);
  position:relative;overflow:hidden;
}
.stat-card::before{
  content:'';position:absolute;top:0;right:0;
  width:80px;height:80px;
  border-radius:50%;transform:translate(20px,-20px);
  opacity:0.15;
}
.stat-card.blue::before{background:var(--royal-blue)}
.stat-card.gold::before{background:var(--gold)}
.stat-card.green::before{background:var(--success)}
.stat-card.red::before{background:var(--danger)}
.stat-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-glow)}
.stat-icon{width:44px;height:44px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;margin-bottom:12px}
.stat-icon.blue{background:rgba(26,58,140,0.3);color:#60a5fa}
.stat-icon.gold{background:rgba(212,160,23,0.2);color:var(--gold-light)}
.stat-icon.green{background:rgba(34,197,94,0.2);color:#4ade80}
.stat-icon.red{background:rgba(239,68,68,0.2);color:#f87171}
.stat-value{font-size:1.8rem;font-weight:800;font-family:var(--font-display)}
.stat-label{font-size:0.8rem;color:var(--gray-400);margin-top:4px}
.stat-change{font-size:0.75rem;color:var(--success);margin-top:6px}

/* ============================================
   PAGE SECTIONS (visibility)
============================================ */
.page{display:none}
.page.active{display:block}

/* ============================================
   LANDING PAGE
============================================ */
#landing-page{min-height:100vh}

/* Navbar */
.navbar{
  position:fixed;top:0;left:0;right:0;z-index:500;
  padding:16px 40px;
  display:flex;align-items:center;justify-content:space-between;
  background:rgba(10,22,40,0.85);
  backdrop-filter:blur(20px);
  border-bottom:1px solid var(--glass-border);
  transition:var(--transition);
}
.navbar-brand{display:flex;align-items:center;gap:12px}
.navbar-logo{width:44px;height:44px;background:linear-gradient(135deg,var(--royal-blue),var(--gold));border-radius:10px;display:flex;align-items:center;justify-content:center;font-family:var(--font-display);font-weight:900;font-size:1.1rem;color:white}
.navbar-title{font-family:var(--font-display);font-size:1rem;font-weight:700;line-height:1.2}
.navbar-title span{display:block;font-size:0.7rem;color:var(--gold);font-family:var(--font-body);font-weight:500;letter-spacing:1px;text-transform:uppercase}
.navbar-links{display:flex;align-items:center;gap:6px}
.navbar-links a{padding:8px 16px;border-radius:50px;font-size:0.85rem;font-weight:500;transition:var(--transition);color:var(--gray-200)}
.navbar-links a:hover{color:var(--white);background:var(--glass)}
.navbar-cta{display:flex;gap:10px}
.hamburger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:8px}
.hamburger span{display:block;width:24px;height:2px;background:var(--white);border-radius:2px;transition:var(--transition)}

/* Hero */
.hero{
  min-height:100vh;
  display:flex;align-items:center;
  padding:120px 40px 80px;
  position:relative;overflow:hidden;
}
.hero-bg{
  position:absolute;inset:0;
  background:radial-gradient(ellipse 80% 60% at 50% -10%, rgba(26,58,140,0.6) 0%, transparent 60%),
             radial-gradient(ellipse 40% 40% at 80% 80%, rgba(212,160,23,0.15) 0%, transparent 50%),
             linear-gradient(180deg, var(--deep-navy) 0%, #0a0e1a 100%);
}
.hero-grid{
  position:absolute;inset:0;
  background-image:linear-gradient(rgba(26,58,140,0.15) 1px,transparent 1px),
                   linear-gradient(90deg,rgba(26,58,140,0.15) 1px,transparent 1px);
  background-size:60px 60px;
  animation:gridMove 20s linear infinite;
}
@keyframes gridMove{from{transform:translateY(0)}to{transform:translateY(60px)}}
.hero-particles{position:absolute;inset:0;pointer-events:none}
.particle{
  position:absolute;width:4px;height:4px;border-radius:50%;
  background:var(--gold);opacity:0.6;
  animation:particleFloat 8s ease-in-out infinite;
}
@keyframes particleFloat{
  0%,100%{transform:translateY(0) scale(1);opacity:0.6}
  50%{transform:translateY(-30px) scale(1.5);opacity:0.2}
}
.hero-content{position:relative;z-index:2;max-width:640px}
.hero-badge{
  display:inline-flex;align-items:center;gap:8px;
  background:rgba(212,160,23,0.15);border:1px solid rgba(212,160,23,0.3);
  border-radius:50px;padding:6px 16px;
  font-size:0.8rem;font-weight:600;color:var(--gold-light);
  margin-bottom:24px;
  animation:fadeInDown 0.8s ease;
}
.hero-badge i{font-size:0.7rem}
.hero h1{
  font-family:var(--font-display);
  font-size:clamp(2.4rem,6vw,4.2rem);
  font-weight:900;line-height:1.1;
  margin-bottom:20px;
  animation:fadeInUp 0.8s ease 0.2s both;
}
.hero h1 .highlight{
  background:linear-gradient(135deg,var(--gold),#f8d060);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
  background-clip:text;
}
.hero p{
  font-size:1.05rem;color:var(--gray-200);line-height:1.7;
  margin-bottom:36px;
  animation:fadeInUp 0.8s ease 0.4s both;
}
.hero-buttons{
  display:flex;flex-wrap:wrap;gap:14px;
  animation:fadeInUp 0.8s ease 0.6s both;
}
.hero-visual{
  position:absolute;right:40px;top:50%;transform:translateY(-50%);
  width:420px;z-index:1;
  animation:float 6s ease-in-out infinite;
}
@keyframes float{0%,100%{transform:translateY(-50%) translateX(0)}50%{transform:translateY(calc(-50% - 20px)) translateX(5px)}}
.hero-orb{
  width:380px;height:380px;border-radius:50%;
  background:conic-gradient(from 180deg, var(--royal-blue), #1e4fd0, var(--gold), #2a5ad4, var(--royal-blue));
  opacity:0.2;filter:blur(60px);
  position:absolute;right:-40px;top:50%;transform:translateY(-50%);
  animation:orbPulse 8s ease-in-out infinite;
}
@keyframes orbPulse{0%,100%{transform:translateY(-50%) scale(1)}50%{transform:translateY(-50%) scale(1.1)}}
.hero-card-float{
  position:absolute;right:60px;top:50%;transform:translateY(-50%);
  display:flex;flex-direction:column;gap:16px;z-index:2;
}
.floating-stat{
  background:rgba(15,32,64,0.9);
  border:1px solid var(--glass-border);
  border-radius:var(--radius);
  padding:16px 20px;
  backdrop-filter:blur(20px);
  box-shadow:var(--shadow-card);
  min-width:200px;
}
.floating-stat .num{font-size:1.8rem;font-weight:800;font-family:var(--font-display);color:var(--gold-light)}
.floating-stat .lbl{font-size:0.78rem;color:var(--gray-400)}

/* Sections */
.section{padding:90px 40px}
.section-header{text-align:center;margin-bottom:60px}
.section-label{
  font-size:0.78rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;
  color:var(--gold);margin-bottom:12px;display:block;
}
.section-title{font-family:var(--font-display);font-size:clamp(1.8rem,4vw,2.8rem);font-weight:900;line-height:1.2;margin-bottom:16px}
.section-sub{color:var(--gray-400);max-width:560px;margin:0 auto;font-size:0.95rem;line-height:1.7}

/* Why Choose Us */
.features-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px}
.feature-card{
  background:var(--glass);border:1px solid var(--glass-border);
  border-radius:var(--radius);padding:28px;
  transition:var(--transition);
  position:relative;overflow:hidden;
}
.feature-card::after{
  content:'';position:absolute;bottom:0;left:0;right:0;height:2px;
  background:linear-gradient(90deg,transparent,var(--gold),transparent);
  transform:scaleX(0);transition:var(--transition);
}
.feature-card:hover{transform:translateY(-6px);background:var(--glass-hover)}
.feature-card:hover::after{transform:scaleX(1)}
.feature-icon{
  width:52px;height:52px;border-radius:12px;
  background:linear-gradient(135deg,rgba(26,58,140,0.5),rgba(26,58,140,0.2));
  border:1px solid rgba(26,58,140,0.4);
  display:flex;align-items:center;justify-content:center;
  font-size:1.3rem;color:var(--gold);margin-bottom:16px;
}
.feature-card h3{font-size:1rem;font-weight:700;margin-bottom:8px}
.feature-card p{font-size:0.85rem;color:var(--gray-400);line-height:1.6}

/* Stats Counter */
.stats-section{
  background:linear-gradient(135deg,rgba(26,58,140,0.3),rgba(212,160,23,0.1));
  border-top:1px solid var(--glass-border);
  border-bottom:1px solid var(--glass-border);
}
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:30px;text-align:center}
.counter-item .counter-num{font-family:var(--font-display);font-size:2.8rem;font-weight:900;color:var(--gold)}
.counter-item .counter-label{font-size:0.85rem;color:var(--gray-400);margin-top:6px}

/* Testimonials */
.testimonials-slider{position:relative;overflow:hidden}
.testimonials-track{display:flex;transition:transform 0.5s ease;gap:24px}
.testimonial-card{
  min-width:calc(33.333% - 16px);
  background:var(--glass);border:1px solid var(--glass-border);
  border-radius:var(--radius);padding:28px;
  flex-shrink:0;
}
.testimonial-card .quote{font-size:2rem;color:var(--gold);line-height:1}
.testimonial-card p{font-size:0.9rem;color:var(--gray-200);line-height:1.7;margin:12px 0 20px}
.testimonial-author{display:flex;align-items:center;gap:12px}
.author-avatar{width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,var(--royal-blue),var(--gold));display:flex;align-items:center;justify-content:center;font-weight:700;font-size:1rem}
.author-name{font-weight:700;font-size:0.9rem}
.author-role{font-size:0.78rem;color:var(--gray-400)}
.slider-controls{display:flex;gap:10px;justify-content:center;margin-top:30px}
.slider-dot{width:10px;height:10px;border-radius:50%;background:var(--glass-border);cursor:pointer;transition:var(--transition)}
.slider-dot.active{background:var(--gold);width:28px;border-radius:5px}

/* Contact */
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px}
.contact-info-item{display:flex;gap:16px;margin-bottom:24px}
.contact-icon{width:44px;height:44px;background:rgba(26,58,140,0.3);border:1px solid rgba(26,58,140,0.5);border-radius:10px;display:flex;align-items:center;justify-content:center;color:var(--gold);flex-shrink:0}
.map-placeholder{background:var(--glass);border:1px solid var(--glass-border);border-radius:var(--radius);height:300px;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:12px;color:var(--gray-400)}

/* TTS Controls */
.tts-bar{
  position:fixed;bottom:24px;left:24px;z-index:400;
  background:rgba(10,22,40,0.95);border:1px solid var(--glass-border);
  border-radius:50px;padding:10px 20px;
  display:flex;align-items:center;gap:12px;
  backdrop-filter:blur(20px);
  box-shadow:var(--shadow-card);
  transition:var(--transition);
}
.tts-bar.hidden-bar{transform:translateY(200px);opacity:0;pointer-events:none}
.tts-text{font-size:0.8rem;color:var(--gray-400)}
.tts-wave{display:flex;gap:3px;align-items:center}
.tts-wave span{display:block;width:3px;background:var(--gold);border-radius:2px;animation:wave 1.2s ease-in-out infinite}
.tts-wave span:nth-child(1){height:8px;animation-delay:0s}
.tts-wave span:nth-child(2){height:14px;animation-delay:0.1s}
.tts-wave span:nth-child(3){height:20px;animation-delay:0.2s}
.tts-wave span:nth-child(4){height:14px;animation-delay:0.3s}
.tts-wave span:nth-child(5){height:8px;animation-delay:0.4s}
.tts-wave.paused span{animation-play-state:paused}
@keyframes wave{0%,100%{transform:scaleY(1)}50%{transform:scaleY(1.6)}}

/* Footer */
footer{background:var(--navy-mid);border-top:1px solid var(--glass-border);padding:40px;text-align:center}
footer .footer-brand{font-family:var(--font-display);font-size:1.2rem;color:var(--gold);margin-bottom:8px}
footer p{font-size:0.82rem;color:var(--gray-400)}

/* ============================================
   LOGIN PAGES
============================================ */
.auth-page{
  min-height:100vh;display:flex;align-items:center;justify-content:center;
  background:radial-gradient(ellipse 60% 60% at 50% 0%, rgba(26,58,140,0.5),transparent 60%),
             linear-gradient(180deg,var(--deep-navy),#060d1a);
  padding:24px;
}
.auth-card{
  width:100%;max-width:440px;
  background:rgba(15,32,64,0.8);
  border:1px solid var(--glass-border);
  border-radius:var(--radius);
  padding:40px;
  backdrop-filter:blur(30px);
  box-shadow:0 20px 60px rgba(0,0,0,0.6);
}
.auth-logo{
  width:64px;height:64px;
  background:linear-gradient(135deg,var(--royal-blue),var(--gold));
  border-radius:16px;
  display:flex;align-items:center;justify-content:center;
  font-family:var(--font-display);font-weight:900;font-size:1.4rem;
  margin:0 auto 20px;
}
.auth-title{font-family:var(--font-display);font-size:1.8rem;text-align:center;margin-bottom:4px}
.auth-sub{font-size:0.85rem;color:var(--gray-400);text-align:center;margin-bottom:32px}
.auth-divider{height:1px;background:var(--glass-border);margin:24px 0;position:relative}
.auth-divider span{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:var(--navy-mid);padding:0 12px;font-size:0.8rem;color:var(--gray-400)}

/* ============================================
   ADMIN DASHBOARD
============================================ */
.dashboard-layout{
  display:flex;min-height:100vh;
}

/* Sidebar */
.sidebar{
  width:var(--sidebar-w);
  background:var(--navy-mid);
  border-right:1px solid var(--glass-border);
  display:flex;flex-direction:column;
  position:fixed;top:0;left:0;bottom:0;z-index:200;
  transition:var(--transition);
  overflow-y:auto;
}
.sidebar.collapsed{width:72px}
.sidebar-header{padding:20px;border-bottom:1px solid var(--glass-border);display:flex;align-items:center;gap:12px}
.sidebar-logo{width:36px;height:36px;background:linear-gradient(135deg,var(--royal-blue),var(--gold));border-radius:8px;display:flex;align-items:center;justify-content:center;font-family:var(--font-display);font-size:0.9rem;font-weight:900;flex-shrink:0}
.sidebar-name{font-family:var(--font-display);font-size:0.9rem;font-weight:700;white-space:nowrap;transition:var(--transition)}
.sidebar-name span{display:block;font-size:0.65rem;font-family:var(--font-body);color:var(--gold);letter-spacing:0.5px}
.sidebar.collapsed .sidebar-name{opacity:0;pointer-events:none;width:0;overflow:hidden}
.sidebar-nav{flex:1;padding:16px 10px}
.nav-section{margin-bottom:24px}
.nav-section-label{font-size:0.68rem;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--gray-600);padding:0 8px;margin-bottom:8px;transition:var(--transition)}
.sidebar.collapsed .nav-section-label{opacity:0}
.nav-item{
  display:flex;align-items:center;gap:12px;
  padding:10px 12px;border-radius:10px;
  font-size:0.88rem;font-weight:500;color:var(--gray-200);
  cursor:pointer;transition:var(--transition);
  margin-bottom:2px;white-space:nowrap;position:relative;
}
.nav-item i{width:20px;text-align:center;font-size:1rem;flex-shrink:0;transition:var(--transition)}
.nav-item span{transition:var(--transition)}
.sidebar.collapsed .nav-item span{opacity:0;width:0;overflow:hidden}
.sidebar.collapsed .nav-item{justify-content:center}
.nav-item:hover{background:rgba(26,58,140,0.3);color:var(--white)}
.nav-item.active{background:linear-gradient(135deg,rgba(26,58,140,0.6),rgba(26,58,140,0.3));color:var(--white);border-left:3px solid var(--gold)}
.nav-item .badge{margin-left:auto;flex-shrink:0}
.sidebar.collapsed .nav-item .badge{display:none}
.sidebar-footer{padding:16px;border-top:1px solid var(--glass-border)}
.sidebar-user{display:flex;align-items:center;gap:10px;cursor:pointer}
.user-avatar{width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--royal-blue),var(--gold));display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.85rem;flex-shrink:0}
.user-info{transition:var(--transition)}
.user-info .name{font-size:0.85rem;font-weight:600;white-space:nowrap}
.user-info .role{font-size:0.72rem;color:var(--gold)}
.sidebar.collapsed .user-info{opacity:0;width:0;overflow:hidden}

/* Main content */
.main-content{
  margin-left:var(--sidebar-w);
  flex:1;display:flex;flex-direction:column;
  transition:var(--transition);
  min-height:100vh;
}
.main-content.expanded{margin-left:72px}

/* Top bar */
.topbar{
  background:rgba(15,32,64,0.85);
  border-bottom:1px solid var(--glass-border);
  padding:14px 30px;
  display:flex;align-items:center;justify-content:space-between;
  backdrop-filter:blur(20px);
  position:sticky;top:0;z-index:100;
}
.topbar-left{display:flex;align-items:center;gap:16px}
.topbar-toggle{background:var(--glass);border:1px solid var(--glass-border);color:var(--white);width:36px;height:36px;border-radius:8px;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:var(--transition)}
.topbar-title{font-family:var(--font-display);font-size:1.1rem;font-weight:700}
.topbar-right{display:flex;align-items:center;gap:12px}
.topbar-search{
  display:flex;align-items:center;gap:8px;
  background:var(--glass);border:1px solid var(--glass-border);
  border-radius:50px;padding:8px 16px;
  font-size:0.85rem;color:var(--gray-400);
  min-width:200px;
}
.topbar-search input{background:none;border:none;color:var(--white);font-size:0.85rem;flex:1;min-width:0}
.notif-btn{position:relative}
.notif-dot{position:absolute;top:6px;right:6px;width:8px;height:8px;background:var(--danger);border-radius:50%;border:2px solid var(--navy-mid)}

/* Inner pages */
.inner-page{display:none;padding:28px 30px;flex:1}
.inner-page.active{display:block}
.page-header{margin-bottom:28px}
.page-header h2{font-family:var(--font-display);font-size:1.6rem;font-weight:800}
.page-header p{color:var(--gray-400);font-size:0.88rem;margin-top:4px}
.page-actions{display:flex;gap:10px;flex-wrap:wrap}

/* Dashboard Grid */
.dash-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.dash-charts{display:grid;grid-template-columns:2fr 1fr;gap:20px;margin-top:24px}
.chart-card{background:var(--glass);border:1px solid var(--glass-border);border-radius:var(--radius);padding:20px}
.chart-card h3{font-size:0.9rem;font-weight:700;color:var(--gray-200);margin-bottom:16px}
.best-students{margin-top:24px;background:var(--glass);border:1px solid var(--glass-border);border-radius:var(--radius);padding:20px}
.student-rank{display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid var(--glass-border)}
.student-rank:last-child{border-bottom:none}
.rank-num{width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,var(--royal-blue),var(--gold));display:flex;align-items:center;justify-content:center;font-size:0.75rem;font-weight:700;flex-shrink:0}
.rank-info{flex:1}
.rank-name{font-size:0.9rem;font-weight:600}
.rank-class{font-size:0.75rem;color:var(--gray-400)}
.rank-score{font-size:1rem;font-weight:800;color:var(--gold)}
.progress-bar-wrap{flex:1;margin:0 12px}
.progress-bar{height:6px;background:rgba(255,255,255,0.1);border-radius:3px;overflow:hidden}
.progress-fill{height:100%;border-radius:3px;background:linear-gradient(90deg,var(--royal-blue),var(--gold))}

/* Students */
.students-toolbar{display:flex;gap:12px;margin-bottom:20px;flex-wrap:wrap}
.students-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:20px}
.student-card{
  background:var(--glass);border:1px solid var(--glass-border);
  border-radius:var(--radius);padding:20px;
  transition:var(--transition);cursor:pointer;
}
.student-card:hover{transform:translateY(-4px);background:var(--glass-hover);border-color:rgba(212,160,23,0.3)}
.student-card-header{display:flex;align-items:center;gap:14px;margin-bottom:14px}
.student-photo{
  width:52px;height:52px;border-radius:12px;
  background:linear-gradient(135deg,var(--royal-blue),#2a5ad4);
  display:flex;align-items:center;justify-content:center;
  font-size:1.1rem;font-weight:700;flex-shrink:0;
  overflow:hidden;
}
.student-photo img{width:100%;height:100%;object-fit:cover}
.student-card h3{font-size:0.95rem;font-weight:700;margin-bottom:2px}
.student-id-tag{font-size:0.72rem;color:var(--gold)}
.student-meta{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.meta-item{font-size:0.78rem;color:var(--gray-400)}
.meta-item strong{color:var(--gray-200);display:block;font-size:0.82rem}
.student-footer{display:flex;justify-content:space-between;align-items:center;margin-top:14px;padding-top:12px;border-top:1px solid var(--glass-border)}

/* Student Profile */
.profile-grid{display:grid;grid-template-columns:1fr 2fr;gap:24px}
.profile-sidebar-card{background:var(--glass);border:1px solid var(--glass-border);border-radius:var(--radius);padding:24px;text-align:center}
.profile-photo-lg{
  width:100px;height:100px;border-radius:20px;
  background:linear-gradient(135deg,var(--royal-blue),var(--gold));
  display:flex;align-items:center;justify-content:center;
  font-size:2rem;font-weight:700;margin:0 auto 16px;
  overflow:hidden;
}
.profile-name{font-family:var(--font-display);font-size:1.3rem;font-weight:700}
.profile-id{font-size:0.8rem;color:var(--gold);margin-top:4px}
.profile-class{font-size:0.85rem;color:var(--gray-400);margin-top:2px}
.profile-stats-mini{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:20px}
.mini-stat{background:rgba(255,255,255,0.05);border-radius:8px;padding:12px;text-align:center}
.mini-stat .val{font-size:1.2rem;font-weight:800;font-family:var(--font-display);color:var(--gold)}
.mini-stat .lab{font-size:0.7rem;color:var(--gray-400);margin-top:2px}
.subject-score-row{display:flex;align-items:center;gap:12px;margin-bottom:10px}
.sub-name{width:120px;font-size:0.85rem;color:var(--gray-200)}
.sub-score{min-width:44px;text-align:right;font-weight:700;font-size:0.9rem}

/* AI Analysis box */
.ai-analysis-box{
  background:linear-gradient(135deg,rgba(26,58,140,0.3),rgba(212,160,23,0.1));
  border:1px solid rgba(212,160,23,0.3);
  border-radius:var(--radius);padding:20px;margin-top:16px;
  position:relative;overflow:hidden;
}
.ai-analysis-box::before{content:'AI';position:absolute;top:-12px;right:20px;font-size:4rem;font-weight:900;font-family:var(--font-display);opacity:0.05;color:var(--gold)}
.ai-badge{display:inline-flex;align-items:center;gap:6px;background:rgba(212,160,23,0.15);border:1px solid rgba(212,160,23,0.3);border-radius:50px;padding:4px 12px;font-size:0.72rem;font-weight:700;color:var(--gold-light);margin-bottom:10px}
.ai-analysis-text{font-size:0.88rem;color:var(--gray-200);line-height:1.7}

/* Attendance */
.attendance-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:16px;margin-bottom:24px}
.att-cal{background:var(--glass);border:1px solid var(--glass-border);border-radius:var(--radius);padding:16px}
.att-cal-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.att-cal-title{font-size:0.85rem;font-weight:700}
.att-days{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}
.att-day{width:100%;aspect-ratio:1;border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:0.65rem;font-weight:600}
.att-day.present{background:rgba(34,197,94,0.25);color:#4ade80}
.att-day.absent{background:rgba(239,68,68,0.25);color:#f87171}
.att-day.late{background:rgba(245,158,11,0.25);color:#fbbf24}
.att-day.excused{background:rgba(59,130,246,0.25);color:#60a5fa}
.att-day.empty{opacity:0}

/* Fees */
.fees-month-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:16px}
.fee-month-card{
  background:var(--glass);border:1px solid var(--glass-border);
  border-radius:var(--radius);padding:16px;transition:var(--transition);
}
.fee-month-card:hover{background:var(--glass-hover)}
.fee-month-name{font-size:0.85rem;font-weight:700;margin-bottom:10px}
.fee-amount{font-size:1.2rem;font-weight:800;font-family:var(--font-display);color:var(--gold)}
.fee-status-row{display:flex;justify-content:space-between;align-items:center;margin-top:8px}
.fee-outstanding{font-size:0.8rem;color:var(--danger);font-weight:600}

/* Notifications */
.notif-list{display:flex;flex-direction:column;gap:12px}
.notif-item{
  background:var(--glass);border:1px solid var(--glass-border);
  border-radius:var(--radius);padding:16px;
  display:flex;gap:14px;transition:var(--transition);
}
.notif-item.unread{border-left:3px solid var(--gold)}
.notif-item:hover{background:var(--glass-hover)}
.notif-icon{width:36px;height:36px;border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:0.9rem}
.notif-body .title{font-size:0.9rem;font-weight:600;margin-bottom:4px}
.notif-body .msg{font-size:0.82rem;color:var(--gray-400);line-height:1.5}
.notif-body .time{font-size:0.72rem;color:var(--gray-600);margin-top:6px}

/* STUDENT PORTAL */
.student-portal{background:var(--deep-navy)}
.student-header{
  background:var(--navy-mid);border-bottom:1px solid var(--glass-border);
  padding:16px 30px;display:flex;align-items:center;justify-content:space-between;
}
.student-main{padding:28px 30px}
.student-welcome{
  background:linear-gradient(135deg,rgba(26,58,140,0.6),rgba(212,160,23,0.2));
  border:1px solid rgba(212,160,23,0.2);
  border-radius:var(--radius);padding:24px 30px;margin-bottom:28px;
  display:flex;align-items:center;gap:20px;
}
.welcome-avatar{width:60px;height:60px;border-radius:14px;background:linear-gradient(135deg,var(--royal-blue),var(--gold));display:flex;align-items:center;justify-content:center;font-size:1.3rem;font-weight:700}
.welcome-text h2{font-family:var(--font-display);font-size:1.3rem}
.welcome-text p{font-size:0.85rem;color:var(--gray-400)}
.student-tabs{display:flex;gap:4px;margin-bottom:24px;border-bottom:1px solid var(--glass-border);padding-bottom:0}
.student-tab{
  padding:10px 20px;border-radius:8px 8px 0 0;
  font-size:0.85rem;font-weight:600;cursor:pointer;
  transition:var(--transition);color:var(--gray-400);
  border:1px solid transparent;border-bottom:none;
}
.student-tab.active{background:var(--glass);color:var(--white);border-color:var(--glass-border);border-bottom-color:var(--navy-mid)}
.student-tab-content{display:none}
.student-tab-content.active{display:block}

/* Animations */
@keyframes fadeInDown{from{transform:translateY(-20px);opacity:0}to{transform:translateY(0);opacity:1}}
@keyframes fadeInUp{from{transform:translateY(30px);opacity:0}to{transform:translateY(0);opacity:1}}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes countUp{from{opacity:0;transform:scale(0.8)}to{opacity:1;transform:scale(1)}}
@keyframes shimmer{0%{background-position:200% center}100%{background-position:-200% center}}
.animate-fade-in{animation:fadeIn 0.6s ease}
.loading-shimmer{
  background:linear-gradient(90deg,var(--glass) 0%,rgba(255,255,255,0.12) 50%,var(--glass) 100%);
  background-size:200% auto;animation:shimmer 1.5s linear infinite;
}

/* Responsive */
@media(max-width:1100px){
  .dash-grid{grid-template-columns:repeat(2,1fr)}
  .dash-charts{grid-template-columns:1fr}
  .stats-grid{grid-template-columns:repeat(2,1fr)}
  .hero-card-float{display:none}
  .hero-orb{display:none}
  .profile-grid{grid-template-columns:1fr}
  .contact-grid{grid-template-columns:1fr}
}
@media(max-width:768px){
  .navbar{padding:14px 20px}
  .navbar-links{display:none}
  .navbar-cta .btn:not(:last-child){display:none}
  .hamburger{display:flex}
  .hero{padding:100px 20px 60px}
  .section{padding:60px 20px}
  .sidebar{transform:translateX(-100%)}
  .sidebar.mobile-open{transform:translateX(0)}
  .main-content{margin-left:0}
  .main-content.expanded{margin-left:0}
  .inner-page{padding:20px}
  .dash-grid{grid-template-columns:1fr 1fr}
  .topbar{padding:12px 20px}
  .stats-grid{grid-template-columns:1fr 1fr}
  .testimonial-card{min-width:calc(100% - 0px)}
  .student-main{padding:16px}
  .form-row{grid-template-columns:1fr}
  .topbar-search{display:none}
}
@media(max-width:480px){
  .dash-grid{grid-template-columns:1fr}
  .hero-buttons{flex-direction:column}
  .hero-buttons .btn{justify-content:center}
  .auth-card{padding:28px 20px}
}

/* Print styles */
@media print{
  .sidebar,.topbar,.tts-bar{display:none}
  .main-content{margin-left:0}
  .inner-page{padding:0}
  body{background:white;color:black}
}
</style>
</head>
<body>

<!-- Toast Container -->
<div id="toast-container"></div>

<!-- TTS Bar -->
<div class="tts-bar hidden-bar" id="ttsBar">
