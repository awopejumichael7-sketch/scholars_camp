  const att = getAttendancePct(s);
  let monthsHtml = MONTHS.slice(0,6).map((m, mi) => {
    const days = s.attendance[mi] || [];
    if (!days.length) return '';
    const present = days.filter(d=>d===1).length;
    const pct = Math.round((present/days.length)*100);
    const dots = days.map((d,i) => `<div class="att-day ${d===1?'present':'absent'}">${i+1}</div>`).join('');
    return `<div class="att-cal">
      <div class="att-cal-header">
        <div class="att-cal-title">${m}</div>
        <span class="badge ${pct>=80?'badge-success':'badge-warning'}">${pct}% (${present}/${days.length})</span>
      </div>
      <div class="att-days">${dots}</div>
    </div>`;
  }).join('');
  container.innerHTML = `
    <div style="display:flex;align-items:center;gap:16px;margin-bottom:20px;flex-wrap:wrap">
      <div class="stat-card blue" style="flex:1;min-width:160px"><div class="stat-value">${att}%</div><div class="stat-label">Overall Attendance</div></div>
      <div style="display:flex;gap:12px;font-size:0.82rem">
