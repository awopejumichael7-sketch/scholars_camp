/* ============================================
   ENHANCED: AUTO-SAVE DRAFT TO sessionStorage
   Prevent data loss if page accidentally refreshes
============================================ */
function autoSaveDraft() {
  try {
    sessionStorage.setItem('sc_students_draft', JSON.stringify(students));
    sessionStorage.setItem('sc_notifs_draft', JSON.stringify(notifications));
    sessionStorage.setItem('sc_results_draft', JSON.stringify(results));
  } catch(e) {}
}

function loadDraft() {
  try {
    const draft = sessionStorage.getItem('sc_students_draft');
    const nDraft = sessionStorage.getItem('sc_notifs_draft');
    const rDraft = sessionStorage.getItem('sc_results_draft');
    if (draft) students = JSON.parse(draft);
    if (nDraft) notifications = JSON.parse(nDraft);
    if (rDraft) results = JSON.parse(rDraft);
  } catch(e) {}
}

// Auto-save every 60 seconds
setInterval(autoSaveDraft, 60000);

// Load draft on startup if available
loadDraft();

