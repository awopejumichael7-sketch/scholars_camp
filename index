   ENHANCED: EXPORT TO CSV
============================================ */
function exportCSV(type) {
  let csv = '', filename = '';
  if (type === 'students') {
    csv = 'ID,Name,Class,Gender,DOB,Parent,Phone,Address,Joined,Username\n';
    csv += students.map(s => `"${s.id}","${s.name}","${s.class}","${s.gender}","${s.dob}","${s.parent}","${s.phone}","${s.address}","${s.joined}","${s.username}"`).join('\n');
    filename = 'students.csv';
  } else if (type === 'performance') {
    csv = 'ID,Name,Class,Math,English,Physics,Chemistry,Biology,Economics,Average,Grade\n';
    csv += students.map(s => {
      const avg = getStudentAvg(s);
      const { grade } = getGrade(avg);
      return `"${s.id}","${s.name}","${s.class}",${s.scores.Mathematics},${s.scores.EnglishLanguage},${s.scores.Physics},${s.scores.Chemistry},${s.scores.Biology},${s.scores.Economics},${avg},"${grade}"`;
    }).join('\n');
    filename = 'performance.csv';
  } else if (type === 'payments') {
    csv = 'ID,Name,Class,Monthly Fee,Total Paid,Outstanding\n';
    csv += students.map(s => `"${s.id}","${s.name}","${s.class}",${s.monthlyFee},${getTotalPaid(s)},${getOutstanding(s)}`).join('\n');
    filename = 'payments.csv';
  }
  const blob = new Blob([csv], { type: 'text/csv' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = filename; a.click();
  URL.revokeObjectURL(url);
  showToast(`Exported ${filename} successfully`, 'success');
}

