/* ============================================
   ENHANCED: STUDENT PROFILE — Score Bars
   Visual score bars inside profile modal
============================================ */
const _buildScoreBars = (s) => SUBJECTS.map(sub => {
  const key = sub.replace(/ /g, '');
  const score = s.scores[key] || 0;
  if (!score) return '';
  const { grade } = getGrade(score);
  const color = score >= 75 ? 'var(--success)' : score >= 60 ? 'var(--info)' : score >= 50 ? 'var(--warning)' : 'var(--danger)';
  return `<div style="margin-bottom:10px">
    <div style="display:flex;justify-content:space-between;font-size:0.82rem;margin-bottom:4px">
      <span>${sub}</span>
      <span style="font-weight:700;color:${color}">${score}% <span class="badge ${getBadgeClass(score)}">${grade}</span></span>
    </div>
    <div class="progress-bar">
      <div class="progress-fill" style="width:${score}%;background:linear-gradient(90deg,${color},${color}aa)"></div>
    </div>
  </div>`;
}).join('');

